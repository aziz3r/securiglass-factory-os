# SecuriGlass Factory OS - Backend API Environment Variables
ENVIRONMENT=development
LOG_LEVEL=INFO

# Base de données PostgreSQL
DATABASE_URL=postgresql://securiglass_admin:SecuriGlass_Admin_2026!MasterKey@localhost:5432/securiglass_db
DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=20

# Cryptographie & Sécurité
SECRET_KEY=replace_with_64_bytes_secure_random_key_in_production
TDE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # Clé 256 bits hexadécimale
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Paramètres Argon2id (RFC 9106)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_SALT_LENGTH=16

# Réseau & Sous-réseaux Autorisés
OT_CONTROL_ROOM_CIDR=10.10.20.0/24
OT_GATEWAY_CIDR=10.10.30.0/24
