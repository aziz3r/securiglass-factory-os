# ============================================================================
# SecuriGlass Factory OS - Pile SOC Wazuh : variables d'environnement
# ----------------------------------------------------------------------------
# Copier en `.env` puis remplacer les valeurs, ou lancer `scripts/bootstrap.sh`
# qui genere des mots de passe aleatoires et les fichiers de configuration
# derives (internal_users.yml, wazuh.yml). Le fichier `.env` est ignore par git.
# Aucune valeur de ce modele n'est un secret réel.
# ============================================================================

SOC_TIMEZONE=Europe/Paris
SOC_DASHBOARD_PORT=8443
SOC_INDEXER_PORT=9200
SOC_MANAGER_API_PORT=55000

# Comptes techniques Wazuh (les mots de passe sont des ESPACES RESERVES)
INDEXER_USERNAME=admin
INDEXER_PASSWORD=CHANGEME_INDEXER_PASSWORD
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=CHANGEME_DASHBOARD_PASSWORD
API_USERNAME=wazuh-wui
API_PASSWORD=CHANGEME_API_PASSWORD

# Tas JVM de l'indexeur (a reduire a -Xms512m -Xmx512m sur un poste 8 Go)
INDEXER_JAVA_OPTS="-Xms1g -Xmx1g"
